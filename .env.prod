# ========================================
# 生产环境配置模板
# ⚠ 所有密钥必须在部署前替换为强随机值
# ⚠ 真实凭据禁止提交到版本控制
# ========================================
APP_NAME=challenge_demo
DEBUG=false

DB_HOST=postgres
DB_PORT=5432
DB_USER=REPLACE_WITH_REAL_USER
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=REPLACE_WITH_REAL_DB

REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_USER
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_PASSWORD

JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=30

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD
